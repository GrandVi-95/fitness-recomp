// Fitness & Nutrition Tracking App — Body Recomposition
// Prisma schema for SQLite (development) / PostgreSQL (production)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL is configured in prisma.config.ts (Prisma v7 convention).
  // Set DATABASE_URL in your .env / Vercel env vars.
  // For PgBouncer (Supabase Transaction Mode), also set DIRECT_URL and add
  // directUrl = env("DIRECT_URL") to the defineConfig() in prisma.config.ts.
}

// ─────────────────────────────────────────────
// USER & PROFILE
// ─────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  name            String   @default("Athlete")
  // Recomp targets
  targetCalories  Int      @default(2500)    // kcal/day
  targetProtein   Int      @default(180)     // g/day
  targetFats      Int      @default(69)      // g/day fat (25% of calories)
  targetCarbs     Int      @default(290)     // g/day carbs (remaining calories)
  targetWeight    Float?                     // goal body weight kg
  muscleMassGoal  Float    @default(5.0)     // +5 kg muscle target
  startWeight     Float?                     // baseline body weight kg
  startMuscleMass Float?                     // baseline muscle mass kg
  // Preferences
  splitType       String   @default("PPL")   // PPL | AB | FULL_BODY | CUSTOM
  restSeconds     Int      @default(90)      // default rest timer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]
  nutritionLogs   NutritionLog[]
  bodyMetrics     BodyMetric[]
  progressPhotos  ProgressPhoto[]
  userSettings    UserSettings?
  checkIns        CheckIn[]
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  darkMode             Boolean @default(true)
  proteinAlertEnabled  Boolean @default(true)
  proteinAlertTime     String  @default("14:00") // "HH:MM" — afternoon protein check
  deloadThreshold      Int     @default(3)        // consecutive stalled weeks before deload
  fatiguePacingEnabled Boolean @default(true)
  // AI NLP settings
  aiProvider           String  @default("anthropic") // anthropic | openai | gemini
  aiApiKey             String?                        // user-supplied key (stored in plain text for local dev)
  autoProteinGoal      Boolean @default(true)         // true = latestWeight × 2.2, false = manual
  smartAlertsEnabled   Boolean @default(true)         // show smart nutrition alert banner
  showWeeklySummary    Boolean @default(true)         // show weekly summary card on dashboard
  // Body profile — used for Mifflin-St Jeor TDEE calculation
  height               Int     @default(183)    // cm
  age                  Int     @default(31)     // years
  gender               String  @default("male") // male | female
  activityMultiplier   Float   @default(1.45)   // TDEE multiplier (1.2 sedentary → 1.9 very active)
  autoCalorieGoal      Boolean @default(true)   // true = TDEE from Mifflin-St Jeor, false = manual
  dietaryPreference    String  @default("vegetarian") // vegetarian | vegan | pescatarian | omnivore
  // Weekly report
  reportEnabled        Boolean @default(true)         // send weekly coaching email
  reportEmail          String?                        // recipient — falls back to REPORT_EMAIL env var
  // Controlled Lean Gain Engine — bi-weekly check-in (see CheckIn model)
  // Persistent, CUMULATIVE kcal correction on top of (TDEE × 1.05). A check-in
  // never resets this to a fixed value — it only adds/subtracts ±150 per cycle,
  // so e.g. +150 now and -150 next cycle returns exactly to 0.
  calorieAdjustmentOffset Int @default(0)
  // Vacation Mode — pauses the check-in timer entirely (never "due" while on),
  // never touches calorieAdjustmentOffset, and relaxes AI meal-logging prompts
  // to rough, judgment-free estimates.
  vacationMode            Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// EXERCISE LIBRARY
// ─────────────────────────────────────────────

model Exercise {
  id               String  @id @default(cuid())
  name             String  @unique
  primaryMuscle    String  // chest | back | shoulders | biceps | triceps | legs | core
  secondaryMuscles String  @default("[]") // JSON array stored as string
  equipment        String  @default("barbell") // barbell | dumbbell | cable | machine | bodyweight | kettlebell | household
  instructions     String?
  isCompound       Boolean @default(true)
  // weight_reps (default) | reps_only (bodyweight — weight optional) |
  // duration (isometric holds — logged as seconds, not weight×reps)
  trackingType     String  @default("weight_reps")

  workoutExercises WorkoutExercise[]
  setLogs          SetLog[]
}

// ─────────────────────────────────────────────
// WORKOUT PLANS & TEMPLATES
// ─────────────────────────────────────────────

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  name      String                       // "My PPL Plan"
  splitType String                       // PPL | AB | FULL_BODY | CUSTOM
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]
}

model Workout {
  id           String   @id @default(cuid())
  planId       String
  name         String                   // "Push Day A", "Pull Day B"
  dayLabel     String                   // Push | Pull | Legs | A | B | A-Home | B-Home ...
  order        Int
  muscleGroups String   @default("[]")  // JSON array — ["chest","shoulders","triceps"]
  // gym | home — home workouts are fully separate rows with their own exercise
  // rows, so their set history can never mix with gym history
  environment  String   @default("gym")

  plan      WorkoutPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]
}

model WorkoutExercise {
  id          String  @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int
  targetSets  Int     @default(3)
  targetReps  String  @default("8-12")  // "8-12" | "5" | "AMRAP"
  restSeconds Int     @default(90)
  notes       String?
  // Exercises sharing the same superSetId within a workout are performed
  // back-to-back with no rest between them; sets/reps/weight stay independent.
  superSetId  String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

// ─────────────────────────────────────────────
// WORKOUT SESSIONS (live gym logs)
// ─────────────────────────────────────────────

model WorkoutSession {
  id           String    @id @default(cuid())
  userId       String
  workoutId    String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMins Int?
  // Recovery signals
  fatigueLevel Int?      // 1–5 self-reported post-session
  sleepHours   Float?    // hours slept before session
  notes        String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets    SetLog[]
}

model SetLog {
  id           String   @id @default(cuid())
  sessionId    String
  exerciseId   String
  setNumber    Int
  reps         Int
  weightKg     Float
  rpe          Int?     // Rate of Perceived Exertion 1–10
  isWarmup     Boolean  @default(false)
  durationSecs Int?     // static holds (plank, wall-sit): hold time in seconds
  loggedAt     DateTime @default(now())

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}

// ─────────────────────────────────────────────
// NUTRITION
// ─────────────────────────────────────────────

// Vegetarian food database (seeded with common protein sources)
model Food {
  id           String  @id @default(cuid())
  name         String  @unique
  category     String  // legumes | dairy | egg | protein_supplement | grain | vegetable | nuts_seeds
  isVegetarian Boolean @default(true)
  // Per 100g macros
  caloriesPer100 Float
  proteinPer100  Float
  carbsPer100    Float
  fatPer100      Float
  fiberPer100         Float  @default(0)
  sugarPer100         Float  @default(0)
  saturatedFatPer100  Float  @default(0)
  // Aliases for NLP matching: stored as JSON array string
  aliases             String @default("[]")

  nutritionItems NutritionFoodItem[]
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  mealType  String   @default("snack") // breakfast | lunch | dinner | snack | pre_workout | post_workout
  rawInput  String?  // original natural-language text from user
  notes     String?
  // AI nudge: one gentle Hebrew sentence on protein density / macro efficiency.
  // Only populated when an LLM parsed the meal (free-text NLP) — quick-log paths
  // (voice batch, coffee, label scanner) skip the AI call and leave this null.
  insight   String?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItems NutritionFoodItem[]
}

model NutritionFoodItem {
  id       String  @id @default(cuid())
  logId    String
  foodId   String?
  name     String  // display name (may differ from Food.name)
  quantity Float   // amount in `unit`
  unit     String  @default("g") // g | ml | piece | scoop | cup
  // Computed macros (denormalized for quick aggregation)
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float   @default(0)
  sugar        Float   @default(0)
  saturatedFat Float   @default(0)

  log  NutritionLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  food Food?        @relation(fields: [foodId], references: [id])
}

// ─────────────────────────────────────────────
// RECIPES (leftover / batch logging)
// ─────────────────────────────────────────────

model Recipe {
  id               String   @id @default(cuid())
  userId           String
  name             String
  ingredients      String   @default("")   // raw text description saved for reference
  totalCalories    Float    @default(0)
  totalProtein     Float    @default(0)
  totalCarbs       Float    @default(0)
  totalFat         Float    @default(0)
  totalSugar       Float    @default(0)
  defaultServingPct Float   @default(25)   // % of total batch per standard portion
  createdAt        DateTime @default(now())
}

// ─────────────────────────────────────────────
// BODY METRICS & PROGRESS
// ─────────────────────────────────────────────

model BodyMetric {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @default(now())
  weightKg   Float
  bodyFatPct Float?   // % — from calipers / smart scale
  muscleMassKg Float? // derived: bodyweight * (1 - bodyFatPct/100)
  waistCm    Float?   // waist circumference cm — "Waist Increase" signal for check-ins
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CONTROLLED LEAN GAIN — BI-WEEKLY CHECK-IN ENGINE
// ─────────────────────────────────────────────

// One row per completed bi-weekly check-in. Kept as history (not just a
// pointer field) so the decision matrix can look back at the PREVIOUS
// check-in's trend labels — the "2 consecutive check-ins" rule needs that.
model CheckIn {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  // Noise-filtered trend inputs at the time of this check-in
  weightTrendPct   Float    // 7-day-avg vs prior-7-day-avg, % change per week (signed)
  weightTrendLabel String   // "fast_loss" | "down" | "stable" | "up"
  waistCm          Float?   // waist reading used for this check-in, if any
  waistDeltaCm     Float?   // signed change vs the previous check-in's waistCm
  waistTrendLabel  String   // "down" | "stable" | "up"
  perfTrendLabel   String   // "down" | "stable" | "up" — training volume trend
  // Decision
  decision         String   // "no_change" | "increase" | "decrease"
  offsetDelta      Int      // 0 | +150 | -150 applied this cycle
  offsetAfter      Int      // calorieAdjustmentOffset value after this check-in
  reasoning        String   // short Hebrew explanation shown to the user

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressPhoto {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @default(now())
  url    String   // local blob URL or /uploads path
  angle  String   @default("front") // front | back | side_left | side_right
  notes  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
